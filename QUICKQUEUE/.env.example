# Vercel's Supabase integration creates POSTGRES_URL automatically.
# DATABASE_URL is also accepted for manual or local configuration.
# Replace [YOUR-PASSWORD] and percent-encode reserved characters in the password.
# Never commit the real connection string.
POSTGRES_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@YOUR-POOLER-HOST:6543/postgres
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=15000
CHAT_RATE_LIMIT=12/min
