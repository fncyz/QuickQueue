# Vercel's Supabase integration creates POSTGRES_URL automatically.
# DATABASE_URL is also accepted for manual or local configuration.
# Replace [YOUR-PASSWORD] and percent-encode reserved characters in the password.
# Never commit the real connection string.
POSTGRES_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@YOUR-POOLER-HOST:6543/postgres
# Private Supabase Storage bucket and server-only S3 credentials.
SUPABASE_STORAGE_BUCKET=quickqueue-media
SUPABASE_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your-supabase-storage-region
SUPABASE_STORAGE_ACCESS_KEY_ID=replace-with-s3-access-key-id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=8000
GEMINI_TOTAL_DEADLINE_MS=25000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MODEL_CACHE_SECONDS=900
GEMINI_MODEL_COOLDOWN_SECONDS=60
CHAT_RATE_LIMIT=12/min
QUICKQUEUE_OFFICE_HOURS=Monday–Friday, 8:00 AM–5:00 PM; Saturday, 8:00 AM–12:00 PM; Sunday and holidays, closed.
